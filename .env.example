# Copy this file to .env.local and fill it in. Never commit .env.local.
# Chapter 4.4 shows how to make each value.

# The pooled connection string of your Neon "dev" branch.
DATABASE_URL=

# Long random strings. Make each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OWNER_SECRET=
VISITOR_SECRET=

# Your live address, with no slash at the end. Set it in Vercel for Production only.
NEXT_PUBLIC_SITE_URL=
